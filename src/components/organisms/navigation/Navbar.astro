---
import { getTranslations } from '@i18n/translation';

interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;
const currentLang = currentPath.startsWith('/en') ? 'en' : 'es';

const t = getTranslations(currentLang);

const roomsLink = currentLang === 'en' ? '/en/habitaciones' : '/habitaciones';
const gastronomyLink = currentLang === 'en' ? '/en/gastronomia' : '/gastronomia';
const experiencesLink = currentLang === 'en' ? '/en/experiencias' : '/experiencias';
const contactLink = currentLang === 'en' ? '/en/contacto' : '/contacto';
const bookLink = currentLang === 'en' ? '/en/reservar' : '/reservar';

import LanguageSwitcher from '../../molecules/LanguageSwitcher.astro';
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a href={currentLang === 'en' ? '/en' : '/'} class="flex items-center">
        <img src="/logo.png" alt="Hotel Majestic II Logo" class="h-16 w-auto max-w-40" />
      </a>

      <div class="hidden md:flex items-center absolute left-1/2 transform -translate-x-1/2">
        <div class="flex items-center gap-1">
          <a href={roomsLink} class:list={["relative px-4 py-2 text-sm font-medium transition-all duration-300 group", currentPath.includes('/rooms') || currentPath.includes('/habitaciones') ? "text-white" : "text-white/90 hover:text-white"]}>
            <span class="relative z-10">{t('nav.rooms')}</span>
            <span class:list={["absolute inset-0 bg-white/10 rounded-lg transition-all duration-300", currentPath.includes('/rooms') || currentPath.includes('/habitaciones') ? "opacity-100" : "opacity-0 group-hover:opacity-100"]}></span>
            <span class:list={["absolute bottom-0 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full transition-all duration-300", currentPath.includes('/rooms') || currentPath.includes('/habitaciones') ? "bg-accent w-6" : "bg-accent w-0 group-hover:w-4"]}></span>
          </a>
          <a href={gastronomyLink} class:list={["relative px-4 py-2 text-sm font-medium transition-all duration-300 group", currentPath.includes('/gastronomy') || currentPath.includes('/gastronomia') ? "text-white" : "text-white/90 hover:text-white"]}>
            <span class="relative z-10">{t('nav.gastronomy')}</span>
            <span class:list={["absolute inset-0 bg-white/10 rounded-lg transition-all duration-300", currentPath.includes('/gastronomy') || currentPath.includes('/gastronomia') ? "opacity-100" : "opacity-0 group-hover:opacity-100"]}></span>
            <span class:list={["absolute bottom-0 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full transition-all duration-300", currentPath.includes('/gastronomy') || currentPath.includes('/gastronomia') ? "bg-accent w-6" : "bg-accent w-0 group-hover:w-4"]}></span>
          </a>
          <a href={experiencesLink} class:list={["relative px-4 py-2 text-sm font-medium transition-all duration-300 group", currentPath.includes('/experiences') || currentPath.includes('/experiencias') ? "text-white" : "text-white/90 hover:text-white"]}>
            <span class="relative z-10">{t('nav.experiences')}</span>
            <span class:list={["absolute inset-0 bg-white/10 rounded-lg transition-all duration-300", currentPath.includes('/experiences') || currentPath.includes('/experiencias') ? "opacity-100" : "opacity-0 group-hover:opacity-100"]}></span>
            <span class:list={["absolute bottom-0 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full transition-all duration-300", currentPath.includes('/experiences') || currentPath.includes('/experiencias') ? "bg-accent w-6" : "bg-accent w-0 group-hover:w-4"]}></span>
          </a>
          <a href={contactLink} class:list={["relative px-4 py-2 text-sm font-medium transition-all duration-300 group", currentPath.includes('/contact') || currentPath.includes('/contacto') ? "text-white" : "text-white/90 hover:text-white"]}>
            <span class="relative z-10">{t('nav.contact')}</span>
            <span class:list={["absolute inset-0 bg-white/10 rounded-lg transition-all duration-300", currentPath.includes('/contact') || currentPath.includes('/contacto') ? "opacity-100" : "opacity-0 group-hover:opacity-100"]}></span>
            <span class:list={["absolute bottom-0 left-1/2 -translate-x-1/2 w-1 h-1 rounded-full transition-all duration-300", currentPath.includes('/contact') || currentPath.includes('/contacto') ? "bg-accent w-6" : "bg-accent w-0 group-hover:w-4"]}></span>
          </a>
        </div>
      </div>

<div class="hidden md:flex items-center gap-3">
  <a href={bookLink} class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white font-bold py-2 px-5 rounded-lg transition-all duration-300 hover:shadow-lg hover:shadow-accent/30 transform hover:-translate-y-0.5">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    {t('nav.book')}
  </a>
  <LanguageSwitcher />
</div>

      <button id="mobile-menu-btn" class="md:hidden p-2 text-white hover:text-accent transition-colors" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-white border-t border-gray-100 shadow-lg" role="menu">
    <div class="px-4 py-4 space-y-3">
      <a href={roomsLink} class="block py-2 text-text hover:text-primary font-medium border-b border-gray-100" role="menuitem">{t('nav.rooms')}</a>
      <a href={gastronomyLink} class="block py-2 text-text hover:text-primary font-medium border-b border-gray-100" role="menuitem">{t('nav.gastronomy')}</a>
      <a href={experiencesLink} class="block py-2 text-text hover:text-primary font-medium border-b border-gray-100" role="menuitem">{t('nav.experiences')}</a>
      <a href={contactLink} class="block py-2 text-text hover:text-primary font-medium" role="menuitem">{t('nav.contact')}</a>
      <a href={bookLink} class="block w-full text-center bg-accent hover:bg-accent-dark text-white font-bold py-3 px-4 rounded-lg mt-4 flex items-center justify-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        {t('nav.book')}
      </a>
    </div>
  </div>
</nav>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuItems = mobileMenu?.querySelectorAll('a[role="menuitem"], a[href]');
  
  // Toggle mobile menu with proper ARIA state and focus management
  menuBtn?.addEventListener('click', () => {
    const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
    menuBtn.setAttribute('aria-expanded', String(!isExpanded));
    mobileMenu?.classList.toggle('hidden');
    
    // Focus first item when opening
    if (!isExpanded && menuItems && menuItems.length > 0) {
      setTimeout(() => (menuItems[0] as HTMLElement).focus(), 50);
    } else if (isExpanded) {
      menuBtn.focus();
    }
  });

  // Keyboard navigation for mobile menu
  mobileMenu?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      menuBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.add('hidden');
      menuBtn?.focus();
    }
    
    if (menuItems && menuItems.length > 0) {
      const current = document.activeElement;
      const currentIndex = Array.from(menuItems).indexOf(current as HTMLElement);
      
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        const nextIndex = (currentIndex + 1) % menuItems.length;
        (menuItems[nextIndex] as HTMLElement).focus();
      }
      
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        const prevIndex = (currentIndex - 1 + menuItems.length) % menuItems.length;
        (menuItems[prevIndex] as HTMLElement).focus();
      }
      
      if (e.key === 'Home') {
        e.preventDefault();
        (menuItems[0] as HTMLElement).focus();
      }
      
      if (e.key === 'End') {
        e.preventDefault();
        (menuItems[menuItems.length - 1] as HTMLElement).focus();
      }
    }
  });

  // Close mobile menu on link click
  mobileMenu?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.tagName === 'A' || target.closest('a')) {
      menuBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu.classList.add('hidden');
    }
  });

  // Navbar scroll behavior
  let lastScroll = 0;
  const navbar = document.getElementById('navbar');
  
  window.addEventListener('scroll', () => {
    const currentScroll = window.scrollY;
    
    if (currentScroll > 100) {
      navbar?.classList.add('shadow-md');
      if (currentScroll > lastScroll && currentScroll > 200) {
        navbar?.classList.add('-translate-y-full');
      } else {
        navbar?.classList.remove('-translate-y-full');
      }
    } else {
      navbar?.classList.remove('shadow-md');
      navbar?.classList.remove('-translate-y-full');
    }
    
    lastScroll = currentScroll;
  });
</script>