---
import { getUrlForLang, getCurrentLang } from '@i18n/translation';

const currentPath = Astro.url.pathname;
const currentLang = getCurrentLang(Astro.url);

const esUrl = getUrlForLang('es', currentPath);
const enUrl = getUrlForLang('en', currentPath);

const isEnglish = currentLang === 'en';

const currentFlagSrc = isEnglish ? 'https://flagcdn.com/w40/us.png' : 'https://flagcdn.com/w40/es.png';
const currentFlagAlt = isEnglish ? 'United States flag' : 'Spain flag';
const currentName = isEnglish ? 'English' : 'Español';
---

<div class="relative inline-flex items-center" id="lang-switcher">
  <button
    class="flex items-center gap-1.5 px-2 py-1 text-sm font-medium text-white hover:text-accent transition-colors rounded-lg hover:bg-white/10"
    id="lang-switcher-btn"
    type="button"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label="Seleccionar idioma"
  >
    <!-- Flag: always visible -->
    <img
      src={currentFlagSrc}
      alt={currentFlagAlt}
      width="24"
      height="16"
      class="rounded-sm object-cover shadow-sm"
      style="width:24px;height:16px"
    />
    <!-- Full name: hidden on small screens, visible on md+ -->
    <span class="hidden md:inline text-sm font-medium">{currentName}</span>
    <!-- Chevron: hidden on small screens -->
    <svg class="hidden md:block h-3.5 w-3.5 opacity-70" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    id="lang-switcher-menu"
    class="hidden absolute right-0 top-full mt-2 w-44 origin-top-right rounded-xl shadow-xl py-1.5 bg-white ring-1 ring-black/10 z-50 overflow-hidden"
    role="listbox"
    aria-label="Idiomas disponibles"
  >
    <a
      href={esUrl}
      class:list={[
        "flex items-center gap-3 px-4 py-2.5 text-sm transition-colors",
        !isEnglish
          ? "font-semibold text-primary bg-primary/5"
          : "text-gray-700 hover:bg-gray-50"
      ]}
      role="option"
      aria-selected={!isEnglish}
    >
      <img src="https://flagcdn.com/w40/es.png" alt="Spain flag" width="24" height="16" class="rounded-sm object-cover shadow-sm flex-shrink-0" style="width:24px;height:16px" />
      <span>Español</span>
      {!isEnglish && (
        <svg class="ml-auto h-4 w-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      )}
    </a>
    <a
      href={enUrl}
      class:list={[
        "flex items-center gap-3 px-4 py-2.5 text-sm transition-colors",
        isEnglish
          ? "font-semibold text-primary bg-primary/5"
          : "text-gray-700 hover:bg-gray-50"
      ]}
      role="option"
      aria-selected={isEnglish}
    >
      <img src="https://flagcdn.com/w40/us.png" alt="United States flag" width="24" height="16" class="rounded-sm object-cover shadow-sm flex-shrink-0" style="width:24px;height:16px" />
      <span>English</span>
      {isEnglish && (
        <svg class="ml-auto h-4 w-4 text-primary" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      )}
    </a>
  </div>
</div>

<script>
  const button = document.getElementById('lang-switcher-btn');
  const menu = document.getElementById('lang-switcher-menu');
  const container = document.getElementById('lang-switcher');
  const items = menu?.querySelectorAll('a[role="option"]');

  if (button && menu && container) {
    // Toggle visibility with proper ARIA state
    button.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden', isExpanded);
      
      // Focus first item when opening for keyboard users
      if (!isExpanded && items && items.length > 0) {
        setTimeout(() => (items[0] as HTMLElement).focus(), 50);
      }
    });

    // Keyboard navigation on button
    button.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        button.click();
      }
    });

    // Keyboard navigation within menu
    menu.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        e.preventDefault();
        button.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
        button.focus();
      }
      
      if (items && items.length > 0) {
        const current = document.activeElement;
        const currentIndex = Array.from(items).indexOf(current as HTMLElement);
        
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          const nextIndex = (currentIndex + 1) % items.length;
          (items[nextIndex] as HTMLElement).focus();
        }
        
        if (e.key === 'ArrowUp') {
          e.preventDefault();
          const prevIndex = (currentIndex - 1 + items.length) % items.length;
          (items[prevIndex] as HTMLElement).focus();
        }
        
        if (e.key === 'Home') {
          e.preventDefault();
          (items[0] as HTMLElement).focus();
        }
        
        if (e.key === 'End') {
          e.preventDefault();
          (items[items.length - 1] as HTMLElement).focus();
        }
      }
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!container.contains(e.target as Node)) {
        button.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
      }
    });
  }
</script>